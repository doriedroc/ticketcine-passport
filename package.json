{
  "name": "@doriedroc/ticketcine-passport",
  "version": "0.0.0-development",
  "description": "NestJS module for signing and verifying TicketCine passport tokens",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "format": "prettier --write lib"
  },
  "keywords": [
    "nestjs",
    "passport",
    "ticketcine"
  ],
  "author": {
    "name": "Danilo Cordeiro",
    "email": "dev.danilocordeiro@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doriedroc/ticketcine-passport.git"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "failComment": false
        }
      ]
    ]
  },
  "type": "commonjs",
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@doriedroc/ticketcine-core": "^1.0.4",
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
